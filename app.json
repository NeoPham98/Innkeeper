{
  "expo": {
    "name": "Nhà trọ",
    "slug": "Inkeeper",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/logoApp.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#E3F2FD",
      "image": "./assets/logoApp.png"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.datpq.Inkeeper",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logoApp.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.datpq.Inkeeper"
    },
    "androidStatusBar": {
      "backgroundColor": "#E3F2FD",
      "barStyle": "dark-content",
      "translucent": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "a9c5077d-655a-499c-b6c8-f78f203c03b8"
      }
    }
  }
}
